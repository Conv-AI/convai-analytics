{
  "name": "@convai/analytics",
  "version": "0.2.2",
  "description": "TypeScript SDK for the Convai analytics API. Designed for Claude Code, Codex, Cursor, and Node-side scripts.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "convai",
    "analytics",
    "sdk",
    "latency",
    "observability",
    "ai-agents"
  ],
  "homepage": "https://github.com/Conv-AI/convai-analytics#readme",
  "bugs": {
    "url": "https://github.com/Conv-AI/convai-analytics/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "e2e:stg": "tsx ./e2e/staging.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "node --test --import tsx ./src/**/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.59.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Conv-AI/convai-analytics.git",
    "directory": "packages/typescript"
  },
  "license": "UNLICENSED"
}
