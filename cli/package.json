{
  "name": "@convai/analytics-cli",
  "version": "0.2.2",
  "description": "CLI for the Convai analytics API.",
  "type": "module",
  "bin": {
    "convai-analytics": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "convai",
    "analytics",
    "cli",
    "latency",
    "observability"
  ],
  "homepage": "https://github.com/Conv-AI/convai-analytics/tree/main/cli#readme",
  "bugs": {
    "url": "https://github.com/Conv-AI/convai-analytics/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "prepublishOnly": "node -e \"const p=require('./package.json'); const dep=p.dependencies?.['@convai/analytics']||''; if (dep.startsWith('file:')) { console.error('Refusing to publish with local @convai/analytics dependency. Use the Publish MCP Registry workflow.'); process.exit(1); }\""
  },
  "dependencies": {
    "@convai/analytics": "file:../packages/typescript",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "license": "UNLICENSED"
}
