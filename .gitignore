# Node / TypeScript
# npm is the chosen package manager — package-lock.json is committed for
# reproducible installs and CI caching. yarn.lock / pnpm-lock.yaml stay
# ignored so they can't drift from the npm lockfile.
node_modules/
dist/
build/
*.tsbuildinfo
.npmrc
yarn.lock
pnpm-lock.yaml

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.python-version

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
packages/typescript/e2e/artifacts/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store

# Local env
.env
.env.*
!.env.example
